# ===== Server =====
APP_NAME=AqiCloud-AgentPan API
DEBUG=true
LISTEN_ADDR=:8080

# ===== MySQL =====
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aqi-cloud-pan

# ===== MinIO / S3 =====
MINIO_ENDPOINT=your_minio_endpoint:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=ai-pan
MINIO_AVATAR_BUCKET=avatar

# ===== JWT =====
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_LOGIN_SUBJECT=AQI
JWT_SHARE_SUBJECT=AQI_SHARE

# ===== AI =====
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://your_ollama_host:11434

# ===== AI Agent Stream (SSE proxy) =====
STREAM_BASE_URL=
STREAM_CHAT_PATH=/api/chat/stream

# ===== App =====
FRONTEND_BASE_URL=http://127.0.0.1:8080
DEFAULT_STORAGE_SIZE=10737418240
MAX_UPLOAD_SIZE=104857600
