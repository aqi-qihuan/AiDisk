# =============================================================================
# AiDisk - Unified Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# .env is ignored by git — never commit it.
# =============================================================================

# ===== App Server (AgentPan Backend) =====
AGENTPAN_APP_NAME=AiDisk Agent API
AGENTPAN_DEBUG=true
AGENTPAN_LISTEN_ADDR=:8080

# ===== AI Backend =====
AI_APP_NAME=AiDisk AI API
AI_DEBUG=false
AI_LISTEN_ADDR=:8000

# ===== MySQL (shared) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aqi-cloud-pan

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password
REDIS_MAX_CONNECTIONS=10
REDIS_CHAT_HISTORY_TTL=86400

# ===== MinIO / S3 =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=ai-pan
MINIO_AVATAR_BUCKET=avatar

# ===== JWT =====
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_LOGIN_SUBJECT=AiDisk
JWT_SHARE_SUBJECT=AiDisk_SHARE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== LLM =====
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen3.5:9b
LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key
LLM_TEMPERATURE=0.7
LLM_STREAMING=true

# ===== AI Agent Stream (SSE proxy) =====
STREAM_BASE_URL=
STREAM_CHAT_PATH=/api/chat/stream

# ===== Frontend =====
VITE_API_BASE_URL=http://127.0.0.1:8000/api
FRONTEND_BASE_URL=http://127.0.0.1:8080

# ===== App =====
DEFAULT_STORAGE_SIZE=10737418240
MAX_UPLOAD_SIZE=104857600
TOKEN_DAILY_LIMIT=100000
TOKEN_HOURLY_LIMIT=10000
MAX_CHAT_HISTORY_MESSAGES=20
MAX_CONTEXT_TOKENS=8000
MAX_SUMMARY_LENGTH=500
SUMMARY_TRIGGER_THRESHOLD=10
