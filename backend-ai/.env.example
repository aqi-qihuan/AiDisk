# ===== Redis =====
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password
REDIS_MAX_CONNECTIONS=10
REDIS_CHAT_HISTORY_TTL=86400

# ===== MySQL =====
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aqi-cloud-pan

# ===== JWT =====
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_LOGIN_SUBJECT=AQI

# ===== LLM =====
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen3.5:9b
LLM_OLLAMA_BASE_URL=http://your_ollama_host:11434
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key
LLM_TEMPERATURE=0.7
LLM_STREAMING=true

# ===== App =====
APP_NAME=AI智能体中心API服务
DEBUG=false
LISTEN_ADDR=:8000
FRONTEND_BASE_URL=http://127.0.0.1:8081

# ===== Token Limits =====
TOKEN_DAILY_LIMIT=100000
TOKEN_HOURLY_LIMIT=10000
MAX_CHAT_HISTORY_MESSAGES=20
MAX_CONTEXT_TOKENS=8000
MAX_SUMMARY_LENGTH=500
SUMMARY_TRIGGER_THRESHOLD=10
